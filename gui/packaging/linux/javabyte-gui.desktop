[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %f
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
# Offered under "Open with" for Java programs. It never becomes the default program for them.
MimeType=application/x-java-archive;application/java-archive;

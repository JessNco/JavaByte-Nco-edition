<?xml version="1.0" encoding="utf-8"?>
<!-- Puts JavaByte under "Open with" for .jar files. It adds JavaByte to .jar's OpenWithProgids
     and does not touch .jar's default value, so double-clicking a jar still does whatever it
     did before. Removed with the app. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="JavaByteOpenWith" Guid="6a2b1f0e-3c4d-4e5f-9a8b-7c6d5e4f3a21">
        <RegistryKey Root="HKLM" Key="Software\Classes\JavaByte.jar">
          <RegistryValue Type="string" Value="Java program (analyse with JavaByte)" />
          <RegistryValue Name="FriendlyTypeName" Type="string" Value="Java program" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLDIR]javabyte-gui.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open">
            <RegistryValue Name="FriendlyAppName" Type="string" Value="JavaByte" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]javabyte-gui.exe&quot; &quot;%1&quot;" KeyPath="yes" />
          </RegistryKey>
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="Software\Classes\.jar\OpenWithProgids">
          <RegistryValue Name="JavaByte.jar" Type="string" Value="" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>

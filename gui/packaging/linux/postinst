#!/bin/sh
# Installs the AppArmor profile that lets JavaByte isolate analyses from the network, where the
# system's AppArmor knows about user namespaces (version 4, Ubuntu 24.04 and later). Older
# systems allow them without a profile, and would not understand it.
set -e
if [ -f /etc/apparmor.d/abi/4.0 ] && [ -f /usr/share/javabyte-gui/apparmor-profile ]; then
    cp /usr/share/javabyte-gui/apparmor-profile /etc/apparmor.d/javabyte-gui
    if command -v apparmor_parser > /dev/null && [ -d /sys/kernel/security/apparmor ]; then
        apparmor_parser -r -W /etc/apparmor.d/javabyte-gui || true
    fi
fi
exit 0

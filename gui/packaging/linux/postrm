#!/bin/sh
# Removes the AppArmor profile that postinst installed.
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -f /etc/apparmor.d/javabyte-gui ]; then
        if command -v apparmor_parser > /dev/null && [ -d /sys/kernel/security/apparmor ]; then
            apparmor_parser -R /etc/apparmor.d/javabyte-gui 2> /dev/null || true
        fi
        rm -f /etc/apparmor.d/javabyte-gui
    fi
fi
exit 0
